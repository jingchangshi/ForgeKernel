# Copy to local.env (gitignored): the machine a run uses. Never part of a task.
# The environment wins over this file for any key both set.

# Where the work runs: this machine (local) or one host reachable over ssh (ssh).
FK_DELIVERY=local
# The device index to run on. A CUDA device index on a CUDA task, an Ascend device id
# on an NPU task -- the task's arch decides which, and forgekernel/device.py maps the
# number to the variable that family uses (CUDA_VISIBLE_DEVICES or
# ASCEND_RT_VISIBLE_DEVICES). Either way the job sees device 0 in-process.
# Runs on one device take turns under a per-device lock named for the kind, so gpu0
# and npu0 are different locks and can be busy at the same time.
FK_GPU=0

# ssh only: a host alias that logs in without a prompt, a directory on it used only by
# forgekernel (each run replaces trees under it), and optionally a script sourced first.
REMOTE_HOST=
REMOTE_WORKDIR=
REMOTE_ENV_FILE=

# -- agent policy modes -----------------------------------------------------------------
# The machine layer of the three modes (forgekernel/loop/agent_policy.py). They apply to
# every run this machine starts, including the earliest one -- the judge, written before
# a card's loop.toml exists -- and to every resume.
#
# Precedence: a card's loop.toml [loop] wins, then the value here, then the default.
#
# FK_AGENT_SANDBOX   strict | auto | off                          (default: strict)
#   strict  the OS sandbox is on, must start, and no command may run unsandboxed.
#   auto    on, but a machine where it sometimes cannot start falls back to an
#           unsandboxed command with a warning instead of stopping the turn.
#   off     the OS sandbox is NOT started. This is NOT a security boundary: the deny
#           rules, the PreToolUse hook and the filesystem lists still apply, but they
#           are policy checks, not OS isolation, and the agent notice and every refusal
#           say exactly that. Use it on a machine that cannot start a sandbox at all --
#           bwrap needs unprivileged user namespaces, which
#           apparmor_restrict_unprivileged_userns=1 refuses.
#           On such a machine this is the setting that lets a run start.
#
# FK_AGENT_NETWORK   online | offline    (unset: the role rules, the student offline)
# FK_AGENT_CLUSTER   allow | deny        (unset: the role rules; the student may not
#                                        drive the GPU machine: no ssh, no submits)
#   The two are independent policies, not one switch: a session can have the web and
#   still be barred from the GPU machine, and the reverse.
#
#   Unset is not the same as set: left unset, each role keeps its own rule. An explicit
#   value here overrides the rule for EVERY role, so an active FK_AGENT_NETWORK=offline
#   would take the teacher offline too. Uncomment only to reconfigure the machine.
# FK_AGENT_SANDBOX=strict
# FK_AGENT_NETWORK=offline
# FK_AGENT_CLUSTER=deny

# Credentials for the agents (Claude Code) with provider = "native": one of these, or the
# CLI's own login. A provider of global_config/backends.toml reads its key from the variable
# its key_env names; set that variable here.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
